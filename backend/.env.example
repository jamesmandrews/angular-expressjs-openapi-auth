# Server Configuration
PORT=3000
NODE_ENV=development
SHUTDOWN_TIMEOUT=10000

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=authuser
POSTGRES_PASSWORD=authpass
POSTGRES_DB=authdb
# Connection string (alternative to individual settings)
# DATABASE_URL=postgresql://authuser:authpass@localhost:5432/authdb

# Security Configuration
# Request body size limit (e.g., 10mb, 1mb, 500kb)
REQUEST_BODY_SIZE_LIMIT=10mb

# CORS Configuration
# Comma-separated list of allowed origins (* to allow all)
# If a request comes from example.com and example.com is in this list,
# the response will include example.com in the Access-Control-Allow-Origin header
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://example.com

# Rate Limiting
# Window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# JWT Configuration
# Secret key for signing JWTs (REQUIRED in production - use a strong random string)
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# Access token expiration in seconds (default: 900 = 15 minutes)
JWT_ACCESS_TOKEN_EXPIRY=300

# Refresh threshold percentage (default: 50)
# Token will only be refreshed if this percentage of its lifetime has elapsed
# Set to 75 to only allow refresh in the last 25% of token lifetime
JWT_REFRESH_THRESHOLD_PERCENT=50

# Refresh token expiration in seconds (default: 86400 = 24 hours)
# Refresh tokens are stored in HttpOnly cookies and rotated on each use
REFRESH_TOKEN_EXPIRY=86400

# Enable token blacklist for immediate logout (default: false)
# Set to true for long-lived tokens, false for short-lived tokens to reduce DB overhead
ENABLE_TOKEN_BLACKLIST=false

# Password Reset Configuration
# Reset token expiration in seconds (default: 3600 = 1 hour)
PASSWORD_RESET_TOKEN_EXPIRY=3600

# URL for password reset links (frontend route that handles the reset)
PASSWORD_RESET_URL=http://localhost:4200/reset-password

# Email Verification Configuration
# Verification token expiration in seconds (default: 86400 = 24 hours)
EMAIL_VERIFICATION_TOKEN_EXPIRY=86400

# URL for email verification links (frontend route that handles verification)
EMAIL_VERIFICATION_URL=http://localhost:4200/verify-email

# Password Hashing
# Bcrypt salt rounds (default: 10, higher = more secure but slower)
BCRYPT_SALT_ROUNDS=10

# Email Configuration
# Provider: stub (logs only, default), smtp
EMAIL_PROVIDER=stub

# SMTP Configuration (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# User Type Registration Configuration
# Maps user types to their default roles during registration
# Format: type:role,type:role,...
# Example: USER_TYPE_ROLES=user:user,store_owner:store_owner,merchant:merchant
# Default: user:user (if not specified, only 'user' type is allowed)
USER_TYPE_ROLES=user:user

# Audit Logging Configuration
# Enable/disable audit logging (default: true)
AUDIT_LOG_ENABLED=true

# Number of days to retain audit logs before cleanup (default: 90)
AUDIT_LOG_RETENTION_DAYS=90

# Plugin Configuration
# Comma-separated list of plugin names to disable (by plugin.name, not filename)
# Example: DISABLED_PLUGINS=example-logger,audit-database
# Note: block-plus-aliases is disabled by default (prevents user+alias@email.com registrations)
DISABLED_PLUGINS=block-plus-aliases

# Two-Factor Authentication (2FA) Configuration
# Name shown in authenticator apps (e.g., Google Authenticator, Authy)
TOTP_ISSUER=MyApp

# TOTP window - accept codes within ±N time steps (30 seconds each)
# 0 = only current code, 1 = ±30 seconds, 2 = ±60 seconds (default: 1)
TOTP_WINDOW=2

# Comma-separated list of roles that require 2FA (e.g., admin,moderator)
# Users with these roles will be prompted to set up 2FA
TWO_FACTOR_REQUIRED_ROLES=

# Grace period in hours before 2FA is enforced for users in required roles (default: 24)
# New users or newly assigned roles have this time to set up 2FA
TWO_FACTOR_GRACE_PERIOD_HOURS=24
