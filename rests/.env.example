# Copy this file to .env and add your tokens
# This file is gitignored - your tokens won't be committed

# After login, copy the accessToken from the response here
ACCESS_TOKEN=your-jwt-token-here

# After forgot-password, copy the reset token from email here
PASSWORD_RESET_TOKEN=your-reset-token-here

# After register, copy the verification token from email here
EMAIL_VERIFICATION_TOKEN=your-verification-token-here
