### Variables
@baseUrl = http://localhost:3000/api/v1
@contentType = application/json

# Access token from environment variable or .env file
# Set ACCESS_TOKEN in rests/.env (gitignored) or as an environment variable
# After login, copy the accessToken value to your rests/.env file:
#   ACCESS_TOKEN=eyJhbGci...
@accessToken = {{$dotenv ACCESS_TOKEN}}
@passwordResetToken = {{$dotenv PASSWORD_RESET_TOKEN}}
@emailVerificationToken = {{$dotenv EMAIL_VERIFICATION_TOKEN}}

### ===========================================
### Authentication Endpoints
### ===========================================

### Register a new user
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "thenetimp+user1@gmail.com",
  "password": "SecurePass123",
  "firstName": "John",
  "lastName": "Doe"
}

### Register - minimal (just email and password)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "thenetimp@gmail.com",
  "password": "SecurePass123"
}

### Login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "thenetimp@gmail.com",
  "password": "SecurePass123"
}

### Get current user profile (requires auth)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### Refresh access token (requires valid token)
POST {{baseUrl}}/auth/refresh
Authorization: Bearer {{accessToken}}

### Logout (requires auth)
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}

### ===========================================
### Password Reset Flow
### ===========================================

### Request password reset email
POST {{baseUrl}}/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "thenetimp@gmail.com"
}

### Reset password with token (get token from email)
POST {{baseUrl}}/auth/reset-password
Content-Type: {{contentType}}

{
  "token": "{{passwordResetToken}}",
  "password": "NewSecurePass456"
}

### ===========================================
### Email Verification Flow
### ===========================================

### Verify email with token (get token from email after registration)
POST {{baseUrl}}/auth/verify-email
Content-Type: {{contentType}}

{
  "token": "{{emailVerificationToken}}"
}

### Resend verification email (requires auth)
POST {{baseUrl}}/auth/resend-verification
Authorization: Bearer {{accessToken}}

### ===========================================
### Profile Management
### ===========================================

### Update profile (requires auth)
PATCH {{baseUrl}}/auth/me
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "firstName": "John",
  "lastName": "Smith"
}

### Change password (requires auth and current password)
POST {{baseUrl}}/auth/change-password
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "currentPassword": "SecurePass123",
  "newPassword": "NewSecurePass456"
}

### ===========================================
### Error Cases (for testing)
### ===========================================

### Register - duplicate email (should return 409)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "thenetimp@gmail.com",
  "password": "AnotherPass123"
}

### Register - invalid email format (should return 422)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "not-an-email",
  "password": "SecurePass123"
}

### Register - password too short (should return 422)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "thenetimp+test@gmail.com",
  "password": "short"
}

### Login - wrong password (should return 401)
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "thenetimp@gmail.com",
  "password": "WrongPassword123"
}

### Login - non-existent user (should return 401)
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "thenetimp+nonexistent@gmail.com",
  "password": "SecurePass123"
}

### Get profile without token (should return 401)
GET {{baseUrl}}/auth/me
